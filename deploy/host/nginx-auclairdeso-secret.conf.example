# Secret value of the access cookie of the acceptance environment.
# Installed on the VPS as /etc/nginx/auclairdeso-recette.conf, CHANGE_ME replaced by a random value.
# The real file is never committed: whoever knows the value can open the site without the password.
map $cookie_auclairdeso_access $auclairdeso_open {
    "CHANGE_ME" 1;
    default     0;
}

map $host $auclairdeso_key {
    default "CHANGE_ME";
}
