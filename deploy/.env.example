# Copy to deploy/.env on the VPS and fill in. deploy/.env is never committed.

# Database password of the acceptance environment: openssl rand -hex 24
DB_PASSWORD=

# Address used in magic links, and host names accepted by the Angular server.
# Public address, through the nginx of the VPS (deploy/host/).
# SSH tunnel only: PUBLIC_URL=http://127.0.0.1:8090
PUBLIC_URL=https://vps-5ff241d3.vps.ovh.net:8443
ALLOWED_HOSTS=127.0.0.1,localhost,vps-5ff241d3.vps.ovh.net

# Staff accounts, comma-separated.
ADMINS=tony@auclairdeso.test
PRACTITIONERS=so@auclairdeso.test

# Printed on every bill given to clients (arrêté 83-50/A): first name, last name, then "EI".
# The address is the professional one, on a single line (a domiciliation keeps the home address private).
# Single quotes keep a "#" or a "$" as they are, e.g. BILLING_ADDRESS='1 place de la Mairie, 01150 Chazey-sur-Ain'
BILLING_PRACTITIONER_NAME=
BILLING_ADDRESS=
BILLING_SIRET=
